# AskGo CLI configuration. Copy to .env and edit. Never put passwords here.
ASKGO_BASE_URL=https://askgo.co
ASKGO_DEFAULT_MODEL=
ASKGO_HEADLESS=1
ASKGO_TIMEOUT_MS=60000
ASKGO_STATE_FILE=.askgo/storage_state.json
ASKGO_MEDIA_DIR=media
ASKGO_DEBUG_DIR=debug
ASKGO_SERVE_URL=http://127.0.0.1:9222
# ASKGO_USER_AGENT=
